<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType><RootNamespace></RootNamespace><AssemblyName>CloudReferenceTests</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion><OutputPath>bin\Cloud\</OutputPath><IntermediateOutputPath>obj\Cloud\</IntermediateOutputPath>
    <OptionExplicit>On</OptionExplicit><OptionInfer>On</OptionInfer><OptionStrict>On</OptionStrict>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System"/><Reference Include="System.Core"/><Reference Include="System.Net.Http"/><Reference Include="System.Web.Extensions"/><Reference Include="System.Security"/>
    <Import Include="Microsoft.VisualBasic"/><Import Include="System"/><Import Include="System.Linq"/><Import Include="System.Collections.Generic"/><Import Include="System.Threading.Tasks"/>
    <Compile Include="..\SessionReferenceData.vb"><Link>SessionReferenceData.vb</Link></Compile>
    <Compile Include="..\CloudStorage.vb"><Link>CloudStorage.vb</Link></Compile>
    <Compile Include="..\CloudStorage.SessionReferences.vb"><Link>CloudStorage.SessionReferences.vb</Link></Compile>
    <Compile Include="..\FirebaseClient.vb"><Link>FirebaseClient.vb</Link></Compile>
    <Compile Include="CloudReferenceTests.vb"/>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.VisualBasic.targets" />
</Project>
